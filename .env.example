# =============================================================================
# CYBERSEC AGENT - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Anthropic Claude (paid) - used when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Foundation-Sec-8B (if using HuggingFace)
HUGGINGFACE_TOKEN=your_hf_token_here

# -----------------------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybersec_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Connection string (auto-constructed if not set)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Database - Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# Outreach - Twilio (WhatsApp)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# Outreach - SendGrid (Email)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Send real WhatsApp/Email notifications to experts on handoff.
# Keep false until expert contact details are real (the seed data is made up).
OUTREACH_ENABLED=false

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=CyberSecAgent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=your_secret_key_here_change_in_production

# --- Deployment / security -----------------------------------------------------
# Comma-separated URLs allowed to call the API (set to your Vercel URL when deployed)
ALLOWED_ORIGINS=http://localhost:3000
# Required (X-Admin-Key header) to create/update/delete experts; empty = disabled
ADMIN_API_KEY=
# Per-IP chat limits, to protect the free LLM quota
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=100
# Set to "require" for hosted PostgreSQL such as Neon
POSTGRES_SSLMODE=
